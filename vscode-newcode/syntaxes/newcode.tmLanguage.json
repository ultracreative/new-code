{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "New Code",
  "scopeName": "source.newcode",
  "fileTypes": ["nc"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#extern-block" },
    { "include": "#import-decl" },
    { "include": "#decl-keywords" },
    { "include": "#clause-line" },
    { "include": "#hole" },
    { "include": "#bind" },
    { "include": "#expr-keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#shapes" },
    { "include": "#stdlib" },
    { "include": "#wave-literal" },
    { "include": "#strings" },
    { "include": "#intent-string" },
    { "include": "#numbers" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.newcode",
          "match": "※.*$"
        }
      ]
    },
    "extern-block": {
      "begin": "^\\s*(extern)\\s+(python)\\s*\\{",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.extern.newcode" },
        "2": { "name": "entity.name.type.host.newcode" }
      },
      "end": "^\\s*\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.newcode" }
      },
      "patterns": [
        { "include": "source.python" }
      ]
    },
    "import-decl": {
      "match": "^\\s*(import)\\s+([\\w.]+)(?:\\s+(as)\\s+([A-Za-z_][\\w]*))?",
      "captures": {
        "1": { "name": "keyword.declaration.import.newcode" },
        "2": { "name": "entity.name.namespace.newcode" },
        "3": { "name": "keyword.other.as.newcode" },
        "4": { "name": "entity.name.alias.newcode" }
      }
    },
    "decl-keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.fn.newcode",
          "match": "\\b(fn)\\b"
        },
        {
          "name": "keyword.declaration.let.newcode",
          "match": "\\b(let)\\b"
        },
        {
          "name": "keyword.declaration.process.newcode",
          "match": "\\b(process)\\b"
        },
        {
          "name": "keyword.declaration.module.newcode",
          "match": "\\b(module)\\b"
        }
      ]
    },
    "clause-line": {
      "match": "^\\s*(intent|forbid|ensure|requires|emits|consumes|guard)\\s*:",
      "captures": {
        "1": { "name": "keyword.clause.newcode" }
      }
    },
    "hole": {
      "name": "constant.language.hole.newcode",
      "match": "\\?\\?"
    },
    "bind": {
      "name": "keyword.operator.bind.newcode",
      "match": "(≔|:=)"
    },
    "expr-keywords": {
      "patterns": [
        {
          "name": "keyword.control.newcode",
          "match": "\\b(in|if|then|else|match|with|do|end)\\b"
        },
        {
          "name": "keyword.operator.logical.newcode",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.other.python-escape.newcode",
          "match": "\\b(python)\\s*(?=\\{)"
        },
        {
          "name": "constant.language.boolean.newcode",
          "match": "\\b(true|false|True|False|None)\\b"
        },
        {
          "name": "storage.type.lambda.newcode",
          "match": "(λ|\\\\)(?=[A-Za-z_])"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.newcode",
          "match": "(𝕎|ℝ|ℕ|ℤ|𝔹)"
        },
        {
          "name": "support.type.alias.newcode",
          "match": "\\b(Bool|Int|Float|Number|Str|String|Unit)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.wave.newcode",
          "match": "(⊕|⊚|⇝|⌊|⌉|▶|∥|↺|⁻|⟪|⟫|▷◁|d_γ|d_gamma)"
        },
        {
          "name": "keyword.operator.arrow.newcode",
          "match": "(→|->|⇒|=>)"
        },
        {
          "name": "keyword.operator.compare.newcode",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.newcode",
          "match": "(\\+|-|\\*\\*|\\*|/|%)"
        }
      ]
    },
    "shapes": {
      "name": "support.constant.shape.newcode",
      "match": "\\b(sine|sq|tri|saw|pulse)\\b"
    },
    "stdlib": {
      "patterns": [
        {
          "name": "support.function.wave.newcode",
          "match": "\\b(W|w|Shape|e0|silence|superpose|oscillate|invert|drift|coherence|d_gamma|collapse|collapse_amp|collapse_freq|collapse_rms|fingerprint|identifiability_horizon)\\b"
        },
        {
          "name": "support.function.process.newcode",
          "match": "\\b(Process|every|on|while_|series|parallel|feedback|unfold|drift_process)\\b"
        },
        {
          "name": "support.function.entanglement.newcode",
          "match": "\\b(Entangled|entangle|pitch_follow|amplitude_mirror|phase_opposition|identity)\\b"
        },
        {
          "name": "support.function.host.newcode",
          "match": "\\b(host_load|host_call)\\b"
        },
        {
          "name": "support.function.functional.newcode",
          "match": "\\b(fold_left|fold_right|take|drop|flatten|compose|pipe|repeat|head|tail|init_list|last|reverse|unique|zip_with|map|filter|fmt|show|print|conforms)\\b"
        },
        {
          "name": "support.constant.math.newcode",
          "match": "\\b(pi|tau_const|e_const)\\b"
        }
      ]
    },
    "wave-literal": {
      "name": "constant.other.wave-literal.newcode",
      "begin": "⟨",
      "end": "⟩",
      "patterns": [
        { "include": "#numbers" },
        { "include": "#shapes" },
        {
          "name": "punctuation.separator.newcode",
          "match": ","
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.newcode",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.newcode",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.newcode",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.newcode",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "intent-string": {
      "patterns": [
        {
          "name": "string.quoted.intent.corner.newcode",
          "begin": "「",
          "end": "」",
          "patterns": []
        },
        {
          "name": "string.quoted.intent.double-corner.newcode",
          "begin": "『",
          "end": "』",
          "patterns": []
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.newcode",
          "match": "\\b\\d+\\.\\d+(?:[eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.newcode",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.newcode",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.newcode",
          "match": ":"
        },
        {
          "name": "punctuation.section.parens.begin.newcode",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.newcode",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.brackets.begin.newcode",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.newcode",
          "match": "\\]"
        },
        {
          "name": "punctuation.section.braces.begin.newcode",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.newcode",
          "match": "\\}"
        }
      ]
    }
  }
}
